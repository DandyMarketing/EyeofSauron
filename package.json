{
  "name": "eyeofsauron",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "parse": "tsx src/scripts/parse-sample.ts",
    "ingest": "NODE_USE_ENV_PROXY=1 tsx src/scripts/ingest.ts",
    "dev": "NODE_USE_ENV_PROXY=1 tsx watch src/server.ts",
    "start": "node dist/server.js",
    "ask": "NODE_USE_ENV_PROXY=1 tsx src/scripts/ask.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "ingest:meta": "NODE_USE_ENV_PROXY=1 tsx src/scripts/ingest-meta.ts",
    "backfill:meta": "NODE_USE_ENV_PROXY=1 tsx src/scripts/backfill-meta.ts",
    "backfill:posts": "NODE_USE_ENV_PROXY=1 tsx src/scripts/backfill-meta-posts.ts",
    "features:posts": "NODE_USE_ENV_PROXY=1 tsx src/scripts/recompute-post-features.ts",
    "probe:media": "NODE_USE_ENV_PROXY=1 tsx src/scripts/probe-media-capabilities.ts",
    "ingest:xero": "NODE_USE_ENV_PROXY=1 tsx src/scripts/backfill-xero.ts",
    "probe:bills": "NODE_USE_ENV_PROXY=1 tsx src/scripts/probe-xero-bills.ts",
    "classify:posts": "NODE_USE_ENV_PROXY=1 tsx src/scripts/classify-posts.ts",
    "recommend": "NODE_USE_ENV_PROXY=1 tsx src/scripts/recommend.ts",
    "probe:xero-pl": "NODE_USE_ENV_PROXY=1 tsx src/scripts/probe-xero-pl-layout.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.118.0",
    "@hono/node-server": "^2.0.12",
    "@supabase/supabase-js": "^2.47.0",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.0",
    "hono": "^4.12.32",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
